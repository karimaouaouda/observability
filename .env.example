# Docker Compose project
COMPOSE_PROJECT_NAME=observability

# Existing Grafana deployment (preserved exactly for the initial migration)
GRAFANA_IMAGE=grafana/grafana:13.2.2
GRAFANA_DATA_VOLUME=grafana_data
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3011
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_ADMIN_USER=replace-with-existing-admin-user
GRAFANA_ADMIN_PASSWORD=replace-with-existing-admin-password

# Central metrics
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090

# Central logs; keep loopback-only and expose through protected HTTPS if needed.
LOKI_IMAGE=grafana/loki:3.7.7
LOKI_BIND_ADDRESS=127.0.0.1
LOKI_PORT=3100
